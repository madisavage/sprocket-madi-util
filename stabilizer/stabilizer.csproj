    <Reference Include="$(BepInEx)/interop/Sprocket.Motors.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.VehicleDesigner.Access.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.VehicleFramework.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Vehicles.Cannons.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Vehicles.Weapons.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.WeaponFramework.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tests" />
  </ItemGroup>

</Project>
