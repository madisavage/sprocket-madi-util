<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">$(SPROCKET_GAME_ROOT)</SprocketGameRoot>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</SprocketGameRoot>
    <BepInEx>$(SprocketGameRoot)/BepInEx</BepInEx>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInEx)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInEx)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInEx)/core/0Harmony.dll" Private="false" />
    <Reference Include="$(BepInEx)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Blueprints.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Core.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.CrewDesigner.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.LayingDriveDesigner.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Properties.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.SettingsMenu.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.Vehicles.Crew.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.VehicleDesigner.Access.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.VehicleDesigner.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Sprocket.VehicleFramework.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(BepInEx)/interop/UnityEngine.CoreModule.dll" Private="false" Aliases="UnityCoreModule" />
  </ItemGroup>

  <!-- Pass -p:SkipModDeploy=true for a build that only writes to bin/. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(SkipModDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInEx)/plugins" />
  </Target>

</Project>
