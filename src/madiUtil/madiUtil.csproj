<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>madiUtil</AssemblyName>
    <RootNamespace>MadiUtil</RootNamespace>

    <Version>26.10.1</Version>
    <AssemblyVersion>26.10.1</AssemblyVersion>
    <FileVersion>26.10.1</FileVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>

    <Description>Adds an editable base efficiency field to the crew seat edit pane.</Description>
    <Authors>madi</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/madisavage/sprocket-madi-util.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == '' and '$(SPROCKET_GAME_ROOT)' != ''">$(SPROCKET_GAME_ROOT)</SprocketGameRoot>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</SprocketGameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Il2CppSprocket.Blueprints">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.Blueprints.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleDesigner.Access">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.VehicleDesigner.Access.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleFramework">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.VehicleFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Core">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.CrewDesigner">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.CrewDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Properties">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.Properties.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles.Crew">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2CppSprocket.Vehicles.Crew.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SprocketGameRoot)/MelonLoader/net6/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SprocketGameRoot)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(SprocketGameRoot)/MelonLoader/net6/Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(SprocketGameRoot)/MelonLoader/net6/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SprocketGameRoot)/MelonLoader/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
      <!-- This assembly exports public System.Runtime.CompilerServices.Nullable*Attribute
           stubs; the alias hides them so the compiler synthesizes its own. -->
      <Aliases>UnityCoreModule</Aliases>
    </Reference>
  </ItemGroup>

  <!-- Drops the built DLL into the game next to the other mods. Pass
       -p:SkipModDeploy=true for a build that only writes to bin/. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipModDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SprocketGameRoot)/Mods" />
  </Target>

</Project>
